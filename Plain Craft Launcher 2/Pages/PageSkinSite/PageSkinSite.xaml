<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSkinSite"
    PanScroll="" RenderOptions.BitmapScalingMode="LowQuality">
    <Grid Background="#F5F6F0">
        <!-- 页面主体：不整体滚动，只有角色列表与材质列表各自滚动 -->
        <Grid x:Name="PanMain" Margin="26,20,26,20" />

        <!-- 弹窗层 -->
        <Grid x:Name="PanModal" Visibility="Collapsed">
            <Border x:Name="BorModalBack" Background="#94101F1A" />
            <Border x:Name="BorModal" Width="530" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F9FAF6" BorderBrush="#F2FFFFFF" BorderThickness="1" CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect Color="#051611" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.30" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="26,22,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LabModalTitle" FontSize="20" FontWeight="Bold" Foreground="#14221E" Text="标题" />
                            <TextBlock x:Name="LabModalDesc" Margin="0,6,0,0" FontSize="11.5" Foreground="#66726E" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <local:MyIconButton x:Name="BtnModalClose" Grid.Column="1" Width="32" Height="32" VerticalAlignment="Top" Theme="Color"
                                            LogoScale="0.62" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="#E1E5DE" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="430">
                        <StackPanel x:Name="PanModalBody" />
                    </ScrollViewer>
                    <StackPanel x:Name="PanModalActions" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,18,26,24" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:MyPageRight>
